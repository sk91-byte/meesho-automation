# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/instagram_reseller_db
# For local development without PostgreSQL, sqlite+aiosqlite can be used:
# DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# Security & Secrets
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_bytes_long
SESSION_SECRET=change_this_to_another_super_secret_session_key
ENCRYPTION_KEY=32_byte_hex_or_base64_secret_key_for_aes_gcm_token_encryption
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Groq AI Model Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# Meta Instagram API Configuration
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback
INSTAGRAM_VERIFY_TOKEN=your_webhook_verify_token_here

# App & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TIMEZONE=Asia/Kolkata
